# Database
DATABASE_URL="postgresql://postgres:your_db_password_here@localhost:5432/your_database_name"

# Redis
REDIS_HOST="your_redis_host_here"
REDIS_PORT="6379"

# JWT
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# OpenAI
OPENAI_API_KEY="your_openai_api_key_here"

# Fonnte (WhatsApp service)
FONNTE_API_KEY="your_fonnte_api_key_here"

# Webhook
WEBHOOK_API_KEY="your_webhook_api_key_here"

# App
PORT=3000
NODE_ENV="development"
