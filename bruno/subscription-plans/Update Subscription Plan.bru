meta {
  name: Update Subscription Plan
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/subscriptions/{{subscriptionId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwtToken}}
}

body:json {
  {
    "price": 60000,
    "features": {
      "maxDevices": 5,
      "maxProducts": 500
    }
  }
}
