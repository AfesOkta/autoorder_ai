meta {
  name: Login
  type: http
  uuid: auth-login
  method: POST
  url: {{baseUrl}}/auth/login
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  // Save the JWT token from response for subsequent requests
  if (res.status === 201) {
    const body = res.body;
    if (body.access_token) {
      bru.setEnvVar('jwtToken', body.access_token);
    }
  }
}
